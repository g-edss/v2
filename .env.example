# ============================================================
#  WEB 360 de Calidad — variables de entorno (plantilla)
#  Copiar como .env y ajustar. NUNCA subir el .env real al repo.
# ============================================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=web360
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=web360_calidad
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
# Cadena de conexión que arma el backend a partir de lo anterior
DATABASE_URL=postgresql://web360:cambiar_esta_clave@localhost:5432/web360_calidad

# --- Frontend ---
# URL base del API que consume el frontend
VITE_API_URL=http://localhost:3000/api
